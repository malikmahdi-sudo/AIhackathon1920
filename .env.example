# Local default needs no account or keys. Copy to .env.local if overriding.
STORAGE_DRIVER=local
# For Supabase, set STORAGE_DRIVER=supabase and both server-only values below.
# Never use a NEXT_PUBLIC_ prefix for the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI briefing. Both are server-only; leave empty for headline digest.
OPENAI_API_KEY=
# Choose a Responses API model supporting structured JSON output in your account.
OPENAI_MODEL=
